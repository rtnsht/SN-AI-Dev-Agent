{
  "table": {
    "name": "u_incident_dedupe_rule",
    "label": "Incident Dedup Rule",
    "extends": "",
    "sys_id": "deployed_via_api"
  },
  "columns": [
    {
      "name": "u_name",
      "label": "Name",
      "type": "string",
      "max_length": 100,
      "mandatory": true
    },
    {
      "name": "u_match_fields",
      "label": "Match Fields",
      "type": "string",
      "max_length": 500,
      "mandatory": true,
      "comments": "Comma-separated list of field names to match on"
    },
    {
      "name": "u_time_window_minutes",
      "label": "Time Window (Minutes)",
      "type": "integer",
      "default_value": 30,
      "comments": "Look back window for duplicate detection"
    },
    {
      "name": "u_normalize_description",
      "label": "Normalize Description",
      "type": "boolean",
      "default_value": false,
      "comments": "Apply text normalization for fuzzy matching"
    },
    {
      "name": "u_auto_close_duplicates",
      "label": "Auto-Close Duplicates",
      "type": "boolean",
      "default_value": false,
      "comments": "Automatically close duplicate incidents"
    },
    {
      "name": "u_priority",
      "label": "Priority",
      "type": "integer",
      "default_value": 100,
      "comments": "Rule evaluation order (lower = evaluated first)"
    },
    {
      "name": "u_active",
      "label": "Active",
      "type": "boolean",
      "default_value": true
    }
  ],
  "preconfiguredRules": [
    {
      "u_name": "Correlation ID Match",
      "u_match_fields": "correlation_id",
      "u_time_window_minutes": 60,
      "u_normalize_description": false,
      "u_auto_close_duplicates": true,
      "u_priority": 10,
      "u_active": true
    },
    {
      "u_name": "CI + Category + Description Match",
      "u_match_fields": "cmdb_ci,category,subcategory,short_description",
      "u_time_window_minutes": 30,
      "u_normalize_description": true,
      "u_auto_close_duplicates": false,
      "u_priority": 20,
      "u_active": true
    }
  ]
}

