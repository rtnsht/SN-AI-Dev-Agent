{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["@servicenow/sdk", "@servicenow/glide"],
        "lib": ["ES2020"]
    },
    "include": ["src/**/*.ts", "src/**/*.now.ts"],
    "exclude": ["node_modules", "dist", ".now-sdk-cache"]
}

