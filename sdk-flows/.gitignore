# ── Dependencies ──
node_modules/

# ── Instance-specific config (varies per environment) ──
now.config.json
registry.json

# ── Legacy generated flow workspaces (obsolete) ──
flows/*/
!flows/.gitkeep

# ── Persistent app workspaces ──
apps/*/node_modules
apps/*/dist
apps/*/target
apps/*/.now-sdk-cache
apps/*/.now
!apps/.gitkeep

# ── Build artifacts ──
dist/
target/
.now-sdk-cache/
