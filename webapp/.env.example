# ── AI Provider Keys ──────────────────────────────────────────
# At least one required. Leave blank to require users to bring their own key.
CLAUDE_API_KEY=
OPENROUTER_API_KEY=

# ── ServiceNow Instance (optional) ───────────────────────────
# When set, users won't need to enter instance details manually.
# NOTE: Escape $ signs with \$ in passwords (e.g. pa\$\$word)
SN_INSTANCE_URL=
SN_USERNAME=
SN_PASSWORD=

# ── Rate Limiting ─────────────────────────────────────────────
# Only applies when CLAUDE_API_KEY is set
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_HOURS=4

# ── UI Behavior ──────────────────────────────────────────────
# Allow users to provide their own Claude API key (default: true)
ALLOW_USER_API_KEYS=true
# Show expandable tool cards in chat (default: false)
NEXT_PUBLIC_SHOW_TOOL_DETAILS=false
# Show "Executing: tool_name" live status (default: true)
NEXT_PUBLIC_SHOW_LIVE_STATUS=true

# ── Branding & Theming ───────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Yantra - AI Dev Agent - SN
NEXT_PUBLIC_APP_TAGLINE=Say it. Ship it.
NEXT_PUBLIC_APP_SUBTITLE=Spec-driven · Human-approved · AI-powered
NEXT_PUBLIC_APP_DESCRIPTION=Say it. Ship it. — Spec-driven. Human-approved. AI-powered ServiceNow development.
NEXT_PUBLIC_APP_LOGO=/yantra-logo.png
NEXT_PUBLIC_HERO_TAGLINE=Yantra Works for You.
NEXT_PUBLIC_PRIMARY_COLOR=blue
NEXT_PUBLIC_ACCENT_COLOR=purple
NEXT_PUBLIC_SHOW_INFO_BUTTON=true

# Hero feature pills (format: "Title|Description")
# These appear as cards on the empty chat landing page
NEXT_PUBLIC_HERO_FEATURE_1=Describe what you need. We'll build it.|Tell the AI what you want in plain English — forms, automations, workflows, or custom features — and it handles the rest.
NEXT_PUBLIC_HERO_FEATURE_2=A guided workflow, not a black box.|Every feature follows a structured path: spec → design → build → test → deploy. You review and approve each step before moving on.
NEXT_PUBLIC_HERO_FEATURE_3=You're always in control.|Nothing gets deployed without your sign-off. The AI checks what already exists, reuses what it can, and tracks every change.

# ── Auth Gate (Invite-Only Access) ────────────────────────────
# Supabase connection (required for auth gate)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin credentials (for admin panel access)
ADMIN_EMAIL=
ADMIN_NAME=
# Generate with: node -e "require('bcrypt').hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=

# App URL (used in magic link emails)
APP_URL=http://localhost:3000

# Auth behavior
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_ACCESS_APPROVAL=true

# Session settings
SESSION_COOKIE_NAME=sn-ai-session
SESSION_MAX_AGE_DAYS=1

# Login rate limiting
LOGIN_MAX_ATTEMPTS=3
LOGIN_WINDOW_MINUTES=15

# Magic link / email verification expiry
MAGIC_LINK_EXPIRY_HOURS=72
EMAIL_VERIFY_EXPIRY_HOURS=24

# ── Email Provider (Zeptomail) ────────────────────────────────
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=
ZEPTOMAIL_BOUNCE_ADDRESS=
