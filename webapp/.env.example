# ── Local dev auth bypass ─────────────────────────────────────────────────
# Set to "true" to skip login for local development.
# NEVER set to "true" in production — render.yaml locks this to "false".
BYPASS_AUTH=

# Optional: Set this to provide a server-side Claude API key.
# When set, users won't need to supply their own API key.
# Leave blank or remove to require users to bring their own key.
CLAUDE_API_KEY=

# Optional: Set this to provide a server-side OpenRouter API key.
# When set, users can use OpenRouter models without entering their own key.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Set these to provide server-side ServiceNow credentials.
# When set, users won't need to enter instance details manually.
# Leave blank or remove to require users to bring their own credentials.
# NOTE: Escape $ signs with \$ in passwords (e.g. pa\$\$word)
SN_INSTANCE_URL=https://dev181312.service-now.com
SN_USERNAME=admin
SN_PASSWORD=/HeYgFMgm0@6

# Rate limiting (only applies when CLAUDE_API_KEY is set)
# Max requests per sliding window (default: 10)
RATE_LIMIT_MAX=10
# Sliding window size in hours (default: 4)
RATE_LIMIT_WINDOW_HOURS=4

# Tool execution visibility in chat (default: true)
# When false, shows compact summary instead of expandable tool cards
NEXT_PUBLIC_SHOW_TOOL_DETAILS=false

# Live status visibility - shows what the agent is currently doing (default: true)
# When false, hides the "Executing: tool_name" text and shows only animated dots
NEXT_PUBLIC_SHOW_LIVE_STATUS=true

# Allow users to provide their own Claude API key (default: true)
# When false, the API key input is hidden and only the server-provided key is used
ALLOW_USER_API_KEYS=false

# ── Branding & Theming ──────────────────────────────────────────
# All optional. Defaults to Yantra branding if not set.

# App name shown in header, browser tab, info modal
NEXT_PUBLIC_APP_NAME=Yantra - AI Dev Agent - SN

# Tagline shown on the empty chat screen (large text)
NEXT_PUBLIC_APP_TAGLINE=Say it. Ship it.

# Subtitle shown below the tagline
NEXT_PUBLIC_APP_SUBTITLE=Spec-driven · Human-approved · AI-powered

# Meta description for SEO / browser previews
NEXT_PUBLIC_APP_DESCRIPTION=Say it. Ship it. — Spec-driven. Human-approved. AI-powered ServiceNow development.

# Logo image path (relative to /public or absolute URL)
NEXT_PUBLIC_APP_LOGO=/yantra-logo.png

# Primary color — preset name (blue, purple, green, teal, red, orange, indigo) or hex (#2563eb)
NEXT_PUBLIC_PRIMARY_COLOR=blue

# Accent color — used for AI avatar gradient start. Same format as primary.
NEXT_PUBLIC_ACCENT_COLOR=purple

# Show the info (ℹ) button in the header (default: true)
NEXT_PUBLIC_SHOW_INFO_BUTTON=true

NEXT_PUBLIC_HERO_TAGLINE=r Works for You.

# Hero video embed URL (YouTube or Vimeo embed URL, optional — leave empty to hide)
# Examples:
#   https://www.youtube.com/embed/VIDEO_ID
#   https://player.vimeo.com/video/VIDEO_ID
NEXT_PUBLIC_HERO_VIDEO_URL=


# ── Auth Gate ─────────────────────────────────────────────────
# HMAC secret for email-check hint cookies (anti-enumeration)
# Generate with: openssl rand -hex 32
AUTH_HINT_SECRET=