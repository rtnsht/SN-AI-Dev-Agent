# Admin seed (auto-created on first boot if not exists)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD_HASH=

# Allow users to provide their own Claude API key (default: true)
# When false, the API key input is hidden and only the server-provided key is used
ALLOW_USER_API_KEYS=

# Postgres connection URI for one-off migrations (scripts/apply-supabase-migrations.cjs)
# Supabase → Project Settings → Database → Connection string (URI). Not the same as SUPABASE_URL.
# DATABASE_URL=
# SUPABASE_DB_URL=

# App URL for magic links and redirects
APP_URL=

# HMAC secret for email-check hint cookies (anti-enumeration)
# Generate with: openssl rand -hex 32
AUTH_HINT_SECRET=

# Social share prompt: HMAC for fingerprinting (required in production for share analytics caps)
# Generate with: openssl rand -hex 32
SHARE_HMAC_SECRET=
# Optional dev/staging override instead of the built-in dev fallback (never use in production as the only secret)
SHARE_HMAC_DEV_SECRET=

# Set to "true" to skip login entirely for local development.
# NEVER set this in production — DigitalOcean App Platform env vars explicitly lock it to "false".
BYPASS_AUTH=

# Set to "true" to skip the marketing landing page entirely.
# All visitors hitting "/" will be redirected straight to "/app".
SKIP_LANDING_PAGE=

# Optional: Multiple Claude API keys for pool-based load spreading.
# Comma-separated, no spaces around commas. One is randomly assigned per session.
# Falls back to CLAUDE_API_KEY (below) if empty.
CLAUDE_API_KEYS=

# Optional: Single Claude API key (legacy fallback if CLAUDE_API_KEYS is empty).
CLAUDE_API_KEY=

# Magic link expiry in hours
EMAIL_VERIFY_EXPIRY_HOURS=

# Brute force limits
LOGIN_MAX_ATTEMPTS=
LOGIN_WINDOW_MINUTES=

# Magic link expiry in hours
MAGIC_LINK_EXPIRY_HOURS=

# Accent color — used for AI avatar gradient start. Same format as primary.
NEXT_PUBLIC_ACCENT_COLOR=

# Meta description for SEO / browser previews
NEXT_PUBLIC_APP_DESCRIPTION=

# Logo image path (relative to /public or absolute URL)
NEXT_PUBLIC_APP_LOGO=

# App name shown in header, browser tab, info modal
NEXT_PUBLIC_APP_NAME=

# Subtitle shown below the tagline
NEXT_PUBLIC_APP_SUBTITLE=

# Creator LinkedIn profile URL (shown in footer; leave empty to hide link)
NEXT_PUBLIC_CREATOR_LINKEDIN=

# Creator name shown in the footer attribution (default: "Ratnesh")
NEXT_PUBLIC_CREATOR_NAME=

# Footer tagline — shown above creator attribution (default: "For the ServiceNow community")
NEXT_PUBLIC_FOOTER_TAGLINE=

# Full copyright text after the year — include app name + statement (default: "SN AI Agent. All rights reserved.")
# Example: NEXT_PUBLIC_FOOTER_COPYRIGHT="Acme Corp. All rights reserved."
NEXT_PUBLIC_FOOTER_COPYRIGHT=

# Tagline shown on the empty chat screen (large text)
NEXT_PUBLIC_APP_TAGLINE=

# Landing page feature pills — Format: Title|Description
NEXT_PUBLIC_HERO_FEATURE_1=
NEXT_PUBLIC_HERO_FEATURE_2=
NEXT_PUBLIC_HERO_FEATURE_3=

# Hero tagline shown large on the empty chat screen
NEXT_PUBLIC_HERO_TAGLINE=

# Hero video embed URL (YouTube or Vimeo embed URL, optional — leave empty to hide)
NEXT_PUBLIC_HERO_VIDEO_URL=

# Welcome modal — pill badge text (e.g. "Spec-driven · Human-approved · AI-powered")
NEXT_PUBLIC_WELCOME_BADGE=
# Welcome modal — CTA button label (e.g. "I understand — let's go")
NEXT_PUBLIC_WELCOME_CTA=
# Welcome modal — footer hint (e.g. "This won't show again")
NEXT_PUBLIC_WELCOME_FOOTER=

# Trust bar items (pipe-delimited: "Value|Label") — defaults shown below
# NEXT_PUBLIC_TRUST_ITEM_1=100%|Auditable
# NEXT_PUBLIC_TRUST_ITEM_2=Zero|Black-box decisions
# NEXT_PUBLIC_TRUST_ITEM_3=Safe|Rollback ready
# NEXT_PUBLIC_TRUST_ITEM_4=SDLC|Phase-gated
NEXT_PUBLIC_TRUST_ITEM_1=
NEXT_PUBLIC_TRUST_ITEM_2=
NEXT_PUBLIC_TRUST_ITEM_3=
NEXT_PUBLIC_TRUST_ITEM_4=

# Landing page section headings (leave empty for defaults)
NEXT_PUBLIC_FEATURES_EYEBROW=
NEXT_PUBLIC_FEATURES_TITLE=
NEXT_PUBLIC_STEPS_EYEBROW=
NEXT_PUBLIC_STEPS_TITLE=

# Highlight banner text
NEXT_PUBLIC_HIGHLIGHT_TITLE=
NEXT_PUBLIC_HIGHLIGHT_DESC=

# Footer CTA text
NEXT_PUBLIC_CTA_HEADLINE=
NEXT_PUBLIC_CTA_SUBTEXT=

# Primary color — preset name (blue, purple, green, teal, red, orange, indigo) or hex (#2563eb)
NEXT_PUBLIC_PRIMARY_COLOR=

# Info modal — feature list. JSON array of { "icon", "title", "desc", "example", "tier?" }.
# tier: "primary" (default) = full card with example; "compact" = 2-col grid with icon + one-liner.
# Leave empty to use built-in defaults (3 primary + 4 compact). Invalid/empty JSON falls back to defaults.
# Example:
# NEXT_PUBLIC_INFO_MODAL_FEATURES=[{"icon":"💬","title":"Build with Chat","desc":"Describe what you need.","example":"Add a field when...","tier":"primary"},{"icon":"📦","title":"Change Tracking","desc":"Grouped into update sets.","example":"Q1-Enhancements","tier":"compact"}]
NEXT_PUBLIC_INFO_MODAL_FEATURES=[{"icon":"💬","title":"Build with Chat","desc":"Describe what you need in plain English and the agent builds it on your instance — forms, automations, workflows, catalog items, and more.","example":"\"Add a mandatory justification field when a change request is marked high impact\"","tier":"primary"},{"icon":"📋","title":"Structured Lifecycle","desc":"Every feature goes through Spec → Design → Implementation → Testing → Deployment. You review and approve each phase before the agent moves on — nothing gets deployed without your sign-off.","example":"\"Build an approval workflow for high-priority incidents\" → agent writes a spec first, waits for your OK","tier":"primary"},{"icon":"🔍","title":"Smart Reuse","desc":"Before building anything new, the agent checks what already exists on your instance and reuses or extends it — avoiding duplicates.","example":"Agent finds an existing priority rule and extends it instead of creating a new one","tier":"primary"},{"icon":"📦","title":"Change Tracking","desc":"All changes are grouped into a named update set. Duplicate names are detected before creation.","example":"\"Group these changes under Q1-Enhancements\"","tier":"compact"},{"icon":"🤖","title":"AI Model Choice","desc":"Pick a faster model for quick lookups or a more powerful one for complex features.","example":"Switch models in the settings panel","tier":"compact"},{"icon":"🖼️","title":"Screenshots & Images","desc":"Paste, drag-drop, or attach images. The agent reads UI mockups, errors, and diagrams.","example":"Paste a screenshot and say \"Add a field like this\"","tier":"compact"},{"icon":"🔐","title":"Secure Connection","desc":"Credentials are validated on connect. The agent checks permissions before proceeding.","example":"Warns you if required roles are missing","tier":"compact"}]

# Show the info button in the header (default: true)
NEXT_PUBLIC_SHOW_INFO_BUTTON=

# External changelog URL — shown in the Release dropdown (e.g. GitHub Releases, GitBook)
NEXT_PUBLIC_CHANGELOG_URL=

# Live status visibility — shows what the agent is currently doing (default: true)
NEXT_PUBLIC_SHOW_LIVE_STATUS=

# Tool execution visibility in chat (default: true)
NEXT_PUBLIC_SHOW_TOOL_DETAILS=

# Optional: OpenAI API key for server-side Whisper transcription fallback (Tier 3).
# Used when the browser's native Web Speech API and client-side Whisper both fail.
# Get your key at https://platform.openai.com/api-keys
# Cost: ~$0.006/minute of audio. Leave blank to disable server-side transcription.
OPENAI_API_KEY=

# Optional: Multiple OpenRouter API keys for pool-based load spreading.
# Comma-separated. Falls back to OPENROUTER_API_KEY (below) if empty.
OPENROUTER_API_KEYS=

# Optional: Single OpenRouter API key (legacy fallback if OPENROUTER_API_KEYS is empty).
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Rate limiting (only applies when CLAUDE_API_KEY is set)
# Max requests per sliding window (default: 10)
RATE_LIMIT_MAX=
# Sliding window size in hours (default: 4)
RATE_LIMIT_WINDOW_HOURS=

# Feature flags
REQUIRE_ACCESS_APPROVAL=
REQUIRE_EMAIL_VERIFICATION=

# Session
SESSION_COOKIE_NAME=
SESSION_MAX_AGE_DAYS=

# Optional: ServiceNow credentials
# NOTE: Escape $ signs with \$ in passwords (e.g. pa\$\$word)
SN_INSTANCE_URL=
SN_PASSWORD=
SN_USERNAME=

# Optional: Browser-assisted ServiceNow sign-in / scope switching
# Legacy boolean still works; if BROWSER_SCOPE_SWITCH_MODE is unset and this is "true",
# the app falls back to headless mode for backward compatibility.
ENABLE_BROWSER_SCOPE_SWITCH=
# Modes: headless | headed | cdp
BROWSER_SCOPE_SWITCH_MODE=
# Required when mode=cdp (example: http://127.0.0.1:9222)
BROWSER_SCOPE_SWITCH_CDP_URL=
# Timeout for headed/CDP manual login and MFA completion
BROWSER_SCOPE_SWITCH_MANUAL_TIMEOUT_MS=
# Timeout for headless browser attempts
BROWSER_SCOPE_SWITCH_TIMEOUT_MS=
# Optional rate limits
BROWSER_SCOPE_SWITCH_MAX_ATTEMPTS_PER_HOUR=
BROWSER_CONNECT_MAX_ATTEMPTS_PER_HOUR=

# Supabase (server-side only — no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# ZeptoMail (transactional email)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=
ZEPTOMAIL_BOUNCE_ADDRESS=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=

# Log Persistence — controls log entry enrichment (append entries, counters, telemetry).
# Session row creation in session_logs is always-on via direct write in /api/session-start.
LOG_PERSISTENCE_ENABLED=true
LOG_RETENTION_DAYS=90
LOG_FLUSH_INTERVAL_MS=30000

# ── Log Storage Sync (Object Storage Upload) ────────────────────────
# Periodically uploads log files from webapp/logs/ to S3-compatible object storage.
# Supports multi-provider: upload to multiple destinations simultaneously.

# Master toggle — set to true in production when S3 credentials are configured.
# Default false prevents error spam for developers without storage credentials.
LOG_STORAGE_ENABLED=false

# Comma-separated provider IDs: "s3", "do-spaces", "supabase-s3", "noop"
# Use "noop" for dev/testing (logs uploads but writes nothing).
# Use multiple for dual-write: "do-spaces,supabase-s3"
LOG_STORAGE_PROVIDERS=do-spaces,supabase-s3

# ── Single-provider config (used when LOG_STORAGE_PROVIDERS has one S3 entry) ──
# For multi-provider, use the prefixed vars below instead.
LOG_STORAGE_ENDPOINT=
LOG_STORAGE_REGION=sgp1
LOG_STORAGE_BUCKET=
LOG_STORAGE_ACCESS_KEY=
LOG_STORAGE_SECRET_KEY=

# ── DigitalOcean Spaces (Singapore) ──
LOG_STORAGE_DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
LOG_STORAGE_DO_SPACES_REGION=sgp1
LOG_STORAGE_DO_SPACES_BUCKET=
LOG_STORAGE_DO_SPACES_ACCESS_KEY=
LOG_STORAGE_DO_SPACES_SECRET_KEY=
# LOG_STORAGE_DO_SPACES_FORCE_PATH_STYLE=false  # default; DO Spaces uses virtual hosted-style

# ── Supabase Storage (S3 mode, Singapore) ──
LOG_STORAGE_SUPABASE_S3_ENDPOINT=
LOG_STORAGE_SUPABASE_S3_REGION=ap-southeast-1
LOG_STORAGE_SUPABASE_S3_BUCKET=logs
LOG_STORAGE_SUPABASE_S3_ACCESS_KEY=
LOG_STORAGE_SUPABASE_S3_SECRET_KEY=
LOG_STORAGE_SUPABASE_S3_FORCE_PATH_STYLE=true

# Remote key prefix (default: "logs/")
LOG_STORAGE_PREFIX=logs/

# Scan interval in ms (default: 300000 = 5 min)
LOG_STORAGE_INTERVAL_MS=300000

# Max upload retries per file per provider (default: 3)
LOG_STORAGE_MAX_RETRIES=3

# Minimum file age in ms before uploading — avoids uploading actively-written files (default: 60000 = 60s)
LOG_STORAGE_MIN_FILE_AGE_MS=60000

# Metadata backend: "auto" (prefer Supabase, fallback to local JSON), "supabase", or "local"
LOG_STORAGE_METADATA_BACKEND=supabase