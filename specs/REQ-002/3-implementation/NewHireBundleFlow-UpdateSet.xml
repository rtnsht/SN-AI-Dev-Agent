        <value><![CDATA[(function execute(inputs, outputs) {
    var util = new NewHireBundleUtil();
    var ritmSysId = fd_data.trigger.record.sys_id;

    var result = util.createFulfillmentTasks(ritmSysId);

    outputs.tasks_created = result.success;
    outputs.task_count = result.data ? result.data.length : 0;
    outputs.error_message = result.success ? '' : result.message;

    if (!result.success) {
        gs.error('NewHireBundleOrchestration: Failed to create tasks - ' + result.message);
    }
})(inputs, outputs);]]></value>
