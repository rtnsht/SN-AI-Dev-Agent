    <!-- Script for Action 4 -->
    <sys_hub_action_input action="INSERT_OR_UPDATE">
        <action_instance display_value="Send Completion Notifications">action_newhirebundle_004</action_instance>
        <name>script</name>
        <scope>global</scope>
        <sys_class_name>sys_hub_action_input</sys_class_name>
        <sys_created_by>admin</sys_created_by>
        <sys_created_on>2026-01-20 12:00:00</sys_created_on>
        <sys_id>input_script_004</sys_id>
        <sys_mod_count>0</sys_mod_count>
        <sys_updated_by>admin</sys_updated_by>
        <sys_updated_on>2026-01-20 12:00:00</sys_updated_on>
        <value><![CDATA[(function execute(inputs, outputs) {
    var util = new NewHireBundleUtil();
    var ritmSysId = fd_data.trigger.record.sys_id;

    // Get hiring manager for notification
    var hiringManager = util.getHiringManager(ritmSysId);

    // Get RITM record for event
    var ritm = new GlideRecord('sc_req_item');
    ritm.get(ritmSysId);

    // Fire completion event - notifications will be triggered by event
    gs.eventQueue('newhire.bundle.complete', ritm, hiringManager, ritm.request.requested_for);

    outputs.notifications_sent = true;
    gs.info('NewHireBundleOrchestration: Completion event fired for RITM ' + ritm.number);
})(inputs, outputs);]]></value>
