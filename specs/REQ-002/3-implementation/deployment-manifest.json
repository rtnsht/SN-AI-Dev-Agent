{
  "requirement": "REQ-002",
  "name": "New Hire Equipment Bundle Orchestration",
  "description": "Automated orchestration of fulfillment tasks for new hire equipment bundle with completion tracking and notifications",
  "version": "1.0",
  "created": "2026-01-20",
  "updateSetName": "REQ-002 New Hire Bundle Orchestration",
  "artifacts": [
    {
      "name": "u_hiring_manager",
      "key": "field_hiring_manager",
      "type": "field",
      "table": "sys_dictionary",
      "data": {
        "name": "sc_req_item",
        "element": "u_hiring_manager",
        "column_label": "Hiring Manager",
        "internal_type": "reference",
        "reference": "sys_user",
        "max_length": 32,
        "active": true
      },
      "options": {
        "queryField": "element",
        "displayName": "u_hiring_manager"
      }
    },
    {
      "name": "NewHireBundleUtil",
      "key": "script_include",
      "type": "script_include",
      "table": "sys_script_include",
      "scriptFile": "NewHireBundleUtil.js",
      "data": {
        "name": "NewHireBundleUtil",
        "api_name": "global.NewHireBundleUtil",
        "client_callable": "false",
        "active": "true",
        "access": "public",
        "description": "Utility functions for New Hire Equipment Bundle orchestration - task creation, completion tracking, notifications"
      }
    },
    {
      "name": "NewHireEquipmentBundle",
      "key": "catalog_item",
      "type": "catalog_item",
      "table": "sc_cat_item",
      "data": {
        "name": "New Hire Equipment Bundle",
        "short_description": "Complete equipment bundle for new employees - laptop, access, and welcome kit",
        "description": "Request this item to provision a complete equipment package for a new hire. This includes:\\n- Laptop provisioning\\n- System access and accounts\\n- Welcome kit delivery\\n\\nAll items will be automatically orchestrated and you will be notified when complete.",
        "category": "Hardware",
        "active": "true",
        "workflow": "true",
        "delivery_time": "5 business days"
      },
      "options": {
        "queryField": "name"
      }
    },
    {
      "name": "new_hire_name",
      "key": "var_new_hire_name",
      "type": "catalog_variable",
      "table": "item_option_new",
      "references": {
        "cat_item": "catalog_item"
      },
      "data": {
        "name": "new_hire_name",
        "question_text": "New Hire Name",
        "type": "6",
        "mandatory": "true",
        "order": "100"
      }
    },
    {
      "name": "start_date",
      "key": "var_start_date",
      "type": "catalog_variable",
      "table": "item_option_new",
      "references": {
        "cat_item": "catalog_item"
      },
      "data": {
        "name": "start_date",
        "question_text": "Expected Start Date",
        "type": "10",
        "mandatory": "true",
        "order": "200"
      }
    },
    {
      "name": "hiring_manager",
      "key": "var_hiring_manager",
      "type": "catalog_variable",
      "table": "item_option_new",
      "references": {
        "cat_item": "catalog_item"
      },
      "data": {
        "name": "hiring_manager",
        "question_text": "Hiring Manager",
        "type": "8",
        "reference": "sys_user",
        "mandatory": "true",
        "order": "300"
      }
    },
    {
      "name": "department",
      "key": "var_department",
      "type": "catalog_variable",
      "table": "item_option_new",
      "references": {
        "cat_item": "catalog_item"
      },
      "data": {
        "name": "department",
        "question_text": "Department",
        "type": "8",
        "reference": "cmn_department",
        "mandatory": "false",
        "order": "400"
      }
    },
    {
      "name": "newhire.bundle.complete",
      "key": "event_complete",
      "type": "event",
      "table": "sysevent_register",
      "data": {
        "event_name": "newhire.bundle.complete",
        "table": "sc_req_item",
        "description": "Fired when all fulfillment tasks for a New Hire Bundle are complete",
        "fired_by": "Flow: NewHireBundleOrchestration"
      },
      "options": {
        "queryField": "event_name"
      }
    },
    {
      "name": "New Hire Bundle Complete - Requester",
      "key": "notif_requester",
      "type": "notification",
      "table": "sysevent_email_action",
      "data": {
        "name": "New Hire Bundle Complete - Requester",
        "event_name": "newhire.bundle.complete",
        "subject": "New Hire Equipment Bundle Complete: ${variables.new_hire_name}",
        "collection": "sc_req_item",
        "recipient_fields": "request.requested_for",
        "active": "true",
        "description": "Notifies requester when all new hire bundle tasks are complete"
      }
    },
    {
      "name": "New Hire Bundle Complete - Hiring Manager",
      "key": "notif_manager",
      "type": "notification",
      "table": "sysevent_email_action",
      "data": {
        "name": "New Hire Bundle Complete - Hiring Manager",
        "event_name": "newhire.bundle.complete",
        "subject": "New Hire Equipment Ready: ${variables.new_hire_name}",
        "collection": "sc_req_item",
        "recipient_fields": "u_hiring_manager",
        "active": "true",
        "description": "Notifies hiring manager when new hire bundle is complete and employee is ready to start"
      }
    }
  ],
  "updateSets": [
    {
      "name": "REQ-002 New Hire Bundle Flow",
      "file": "NewHireBundleFlow-UpdateSet.xml",
      "description": "Flow Designer flow for orchestration",
      "importOrder": 2,
      "importCommand": "node mcp-servicenow/lib/import-updateset.js specs/REQ-002/3-implementation/NewHireBundleFlow-UpdateSet.xml --direct"
    }
  ],
  "deploymentSteps": [
    {
      "step": 1,
      "type": "automated",
      "description": "Deploy base artifacts (field, script include, catalog item, events, notifications)",
      "command": "node mcp-servicenow/deploy/deploy.js REQ-002"
    },
    {
      "step": 2,
      "type": "automated",
      "description": "Import Flow Designer flow via REST API",
      "command": "node mcp-servicenow/lib/import-updateset.js specs/REQ-002/3-implementation/NewHireBundleFlow-UpdateSet.xml --direct"
    },
    {
      "step": 3,
      "type": "manual",
      "description": "Configure assignment groups",
      "details": "Ensure assignment groups exist: Hardware Team, IT Security, Facilities. Create them if they don't exist.",
      "estimatedTime": "5 minutes"
    },
    {
      "step": 4,
      "type": "manual",
      "description": "Verify and Activate the Flow",
      "details": "Navigate to Flow Designer, open NewHireBundleOrchestration, verify all steps look correct, and Activate if not already active",
      "estimatedTime": "2 minutes"
    }
  ],
  "dependencies": [
    {
      "type": "plugin",
      "description": "Flow Designer must be active",
      "plugin": "com.glide.hub.flow_designer"
    },
    {
      "type": "data",
      "description": "Assignment groups must exist: Hardware Team, IT Security, Facilities",
      "table": "sys_user_group"
    }
  ],
  "rollback": {
    "steps": [
      "Deactivate/Delete Flow: NewHireBundleOrchestration",
      "Deactivate Catalog Item: New Hire Equipment Bundle",
      "Delete Script Include: NewHireBundleUtil",
      "Remove field: u_hiring_manager from sc_req_item",
      "Deactivate Notifications: New Hire Bundle Complete (Requester/Manager)"
    ]
  }
}

