# ═══════════════════════════════════════════════════════════════
# ServiceNow Instance Configuration
# ═══════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Uncomment ONE environment block at a time
# 3. Fill in credentials for your target environment
# 4. Run setup for each instance to get the API path:
#    node src/deployer/setup-updateset-api.js
#
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# DEV Instance (ACTIVE)
# ─────────────────────────────────────────────────────────────────
SN_INSTANCE_URL=https://yourdev.service-now.com
SN_USERNAME=admin
SN_PASSWORD=your_dev_password
SN_UPDATE_SET_API_PATH=/api/<namespace>/update_set_helper/set_current

# ─────────────────────────────────────────────────────────────────
# TEST Instance
# ─────────────────────────────────────────────────────────────────
# SN_INSTANCE_URL=https://yourtest.service-now.com
# SN_USERNAME=deploy_user
# SN_PASSWORD=your_test_password
# SN_UPDATE_SET_API_PATH=/api/<namespace>/update_set_helper/set_current

# ─────────────────────────────────────────────────────────────────
# UAT Instance
# ─────────────────────────────────────────────────────────────────
# SN_INSTANCE_URL=https://youruat.service-now.com
# SN_USERNAME=deploy_user
# SN_PASSWORD=your_uat_password
# SN_UPDATE_SET_API_PATH=/api/<namespace>/update_set_helper/set_current

# ─────────────────────────────────────────────────────────────────
# PRODUCTION Instance
# ─────────────────────────────────────────────────────────────────
# SN_INSTANCE_URL=https://yourcompany.service-now.com
# SN_USERNAME=deploy_user
# SN_PASSWORD=your_prod_password
# SN_UPDATE_SET_API_PATH=/api/<namespace>/update_set_helper/set_current

# ═══════════════════════════════════════════════════════════════
# Common Settings (apply to all environments)
# ═══════════════════════════════════════════════════════════════
SN_DEFAULT_SCOPE=global
DEBUG=false

# ═══════════════════════════════════════════════════════════════
# Helper API Paths (Auto-detected on instance initialization)
# ═══════════════════════════════════════════════════════════════
# These are auto-detected when using sn_initialize_instance tool.
# Only set manually if you need to override the auto-detected paths.
# SN_UI_POLICY_ACTION_API_PATH=/api/<namespace>/ui_policy_action_helper

# ═══════════════════════════════════════════════════════════════
# Optional: OAuth Configuration (instead of basic auth)
# ═══════════════════════════════════════════════════════════════
# SN_CLIENT_ID=your_client_id
# SN_CLIENT_SECRET=your_client_secret
