# ServiceNow Instance Configuration
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=admin
SN_PASSWORD=your-password

# Optional: OAuth Configuration
# SN_CLIENT_ID=
# SN_CLIENT_SECRET=

# Optional: Default scope for new artifacts
SN_DEFAULT_SCOPE=global

# UpdateSetHelper API path (auto-configured by setup script)
# Each instance has a unique namespace - run setup to configure:
#   node src/deployer/setup-updateset-api.js
# SN_UPDATE_SET_API_PATH=/api/<namespace>/update_set_helper/set_current

# Debug mode
DEBUG=false

