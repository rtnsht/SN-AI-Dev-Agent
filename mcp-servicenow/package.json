{
  "name": "mcp-servicenow",
  "version": "1.0.0",
  "description": "MCP Server for ServiceNow - Enables AI assistants to interact with ServiceNow instances",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-servicenow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "deploy": "node src/deployer/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "servicenow",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "axios-cookiejar-support": "^6.0.5",
    "dotenv": "^16.3.1",
    "tough-cookie": "^6.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
