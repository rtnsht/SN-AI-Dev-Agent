{
  "name": "mcp-servicenow",
  "version": "1.0.0",
  "description": "MCP Server for ServiceNow - Enables AI assistants to interact with ServiceNow instances",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tool-registry": "./dist/tool-registry.js",
    "./tool-definitions": "./dist/tool-definitions.js",
    "./client": "./dist/client/sn-client.js",
    "./types": "./dist/types/index.js"
  },
  "bin": {
    "mcp-servicenow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "deploy": "node src/deployer/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "echo 'Requires SN_INSTANCE_URL, SN_USERNAME, SN_PASSWORD in .env' && node tests/test-scope-switching-enhanced.js"
  },
  "keywords": [
    "mcp",
    "servicenow",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "axios": "^1.21.1",
    "axios-cookiejar-support": "^6.0.5",
    "dotenv": "^16.3.1",
    "tough-cookie": "^6.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
